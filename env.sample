# ═══════════════════════════════════════════════════════════════════
#  EncPlusBot — TheMisfitDK Fork — Environment Configuration
#  Rename this file to .env before starting the bot.
#  Do NOT use quotes around values ( " or ' ).
#  On Heroku: set these in the dashboard or via app.json — no .env needed.
# ═══════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────────
#  REQUIRED  (bot will not start without these)
# ───────────────────────────────────────────────────────────────────

APP_ID=                         # Telegram API ID — from https://my.telegram.org
API_HASH=                       # Telegram API Hash — from https://my.telegram.org
BOT_TOKEN=                      # Bot token — from @BotFather on Telegram
OWNER=                          # Your Telegram user ID(s), space-separated. e.g: 123456 789012


# ───────────────────────────────────────────────────────────────────
#  DATABASE  (strongly recommended — required for Heroku persistence)
# ───────────────────────────────────────────────────────────────────

#DATABASE_URL=                  # MongoDB URI. e.g: mongodb+srv://user:pass@cluster.mongodb.net/ENC
                                 # Without this, data is stored in local pickle files (lost on Heroku restart).
                                 # Free options: MongoDB Atlas (512MB) — https://www.mongodb.com/atlas
                                 #               mLab addon on Heroku (auto-provisioned via app.json)

#DBNAME=ENC                     # MongoDB database name (default: ENC)


# ───────────────────────────────────────────────────────────────────
#  ENCODING
# ───────────────────────────────────────────────────────────────────

#FFMPEG=ffmpeg -y -i """{}""" -preset ultrafast -c:v libx265 -crf 27 -pix_fmt yuv420p10le -map 0:v -c:a aac -map 0:a -c:s copy -map 0:s? """{}"""
                                 # Full encode command. Use """{}""" as input/output placeholders.
                                 # Always include -y (overwrite output) or ffmpeg will hang waiting for input.
                                 # Both ffmpeg and handbrake-cli are supported.
                                 # You can also pass a path to a custom bash script.
                                 #
                                 # ── Examples ──
                                 # H.264/AVC (libx264):
                                 #   ffmpeg -y -i """{}""" -preset medium -c:v libx264 -crf 23 -pix_fmt yuv420p -map 0:v -c:a aac -map 0:a -c:s copy -map 0:s? """{}"""
                                 # H.265/HEVC (libx265):
                                 #   ffmpeg -y -i """{}""" -preset medium -c:v libx265 -crf 27 -pix_fmt yuv420p10le -map 0:v -c:a aac -map 0:a -c:s copy -map 0:s? """{}"""
                                 # AV1 (libsvtav1) — note: -b:v 0 required, CRF is ignored otherwise:
                                 #   ffmpeg -y -i """{}""" -c:v libsvtav1 -preset 6 -crf 30 -b:v 0 -pix_fmt yuv420p10le -map 0:v -c:a libopus -map 0:a -c:s copy -map 0:s? """{}"""

#FFMPEG2=                        # Second encode preset (activate with /set -2 or /v 2)
#FFMPEG3=                        # Third encode preset
#FFMPEG4=                        # Fourth encode preset

#FFMPEG_DOWNLOAD_URL=            # Custom FFmpeg binary URL for jonathanong buildpack.

#MUX_ARGS=                       # ffmpeg args applied after encoding (map/metadata/disposition only — no encode params)


# ───────────────────────────────────────────────────────────────────
#  BOT IDENTITY & CAPTIONS
# ───────────────────────────────────────────────────────────────────

#ENCODER=                        # Your encoder tag — included in output captions. e.g: SubsPlease
#RELEASER=A-P|Anime-Pixel           # Release group name shown in captions
#CAP_DECO=◉                      # Emoji/symbol prepended to captions
#C_LINK=@Pixel_Files                # Channel short link shown in captions
#THUMBNAIL=                      # Telegraph URL for default video thumbnail
#ICON=                           # Telegraph URL for watermark/icon image

# ───────────────────────────────────────────────────────────────────
#  CHANNELS & LOGGING
# ───────────────────────────────────────────────────────────────────

#LOG_CHANNEL=                    # Channel or group ID for bot logs (bot must be admin)
#LOGS_IN_CHANNEL=False           # Dump Python tracebacks to LOG_CHANNEL (default: False)
#FCHANNEL=                       # Channel ID to auto-forward encoded outputs
#FCHANNEL_STAT=                  # Message ID in FCHANNEL to use as live encode status display
#FSTICKER=                       # Sticker file ID to send to FCHANNEL after encode
#FBANNER=False                   # Increase banner message frequency in FCHANNEL (default: False)
#FCODEC=                         # Codec name/quality tag shown in FCHANNEL captions
#NO_BANNER=False                 # Disable all banner messages in FCHANNEL (default: False)
#DUMP_CHANNEL=                   # Channel/group ID to dump leeched (downloaded) videos
#DUMP_LEECH=True                 # Dump leeched videos to bot PM + log channel (default: True)


# ───────────────────────────────────────────────────────────────────
#  USERS & ACCESS CONTROL
# ───────────────────────────────────────────────────────────────────

#TEMP_USERS=                     # Extra allowed user IDs, space-separated (temporary access)
#NO_TEMP_PM=False                # Prevent temp users from using bot in PM (default: False)


# ───────────────────────────────────────────────────────────────────
#  QUEUE & WORKERS
# ───────────────────────────────────────────────────────────────────

#WORKERS=2                       # Pyrogram event worker threads.
                                 # Set to 1 to enforce strict first-come-first-served queue.

#CACHE_DL=False                  # Cache downloads to avoid re-downloading on re-encode (default: False)
#PODI=True                       # Pause download loop while showing download info (default: True)
#LOCK_ON_STARTUP=False           # Start bot in paused state — use /pause off to resume (default: False)


# ───────────────────────────────────────────────────────────────────
#  DOWNLOADER — ARIA2
# ───────────────────────────────────────────────────────────────────

#ARIA2_PORT=6800                 # aria2c RPC port (default: 6800)
#ARIA2_DL_TIMEOUT=0              # Abort aria2 download after N seconds (0 = no timeout)


# ───────────────────────────────────────────────────────────────────
#  TELEGRAM CLIENT SETTINGS
# ───────────────────────────────────────────────────────────────────

#TG_DL_CLIENT=pyrogram           # Client for Telegram downloads: pyrogram or telethon (default: pyrogram)
#TG_UL_CLIENT=pyrogram           # Client for Telegram uploads: pyrogram or telethon (default: pyrogram)
#COMPATIBILITY_MODE=True         # Enable Telethon/Pyrogram compatibility shims (default: True)
#ALLOW_ACTION=True               # Show "encoding…" chat action during encode (default: True)
#FLOOD_SLEEP_THRESHOLD=600       # Max seconds to sleep on FloodWait before giving up (default: 600)


# ───────────────────────────────────────────────────────────────────
#  CAPTIONS & PARSING
# ───────────────────────────────────────────────────────────────────

#USE_ANILIST=True                # Enable AniList metadata lookup for thumbnails & captions (default: True)
#USE_CAPTION=True                # Treat file captions (without newlines) as filenames (default: True)
#FILENAME_AS_CAPTION=False       # Use filename as the upload caption (default: False)
#MI_IN_CAPTION=True              # Include media info summary in caption (default: True)
#EXTENDED_CAPTIONS=True          # Use extended caption format (default: True)
#CUSTOM_RENAME=                  # Default custom rename format string
                                 # Available tokens: {season} {episode} {title} {quality} {codec} {audio}


# ───────────────────────────────────────────────────────────────────
#  UPLOAD OPTIONS
# ───────────────────────────────────────────────────────────────────

#UPLOAD_AS_VIDEO=False           # Upload encoded files as Telegram video (default: False = document)
#UPLOAD_VIDEO_AS_SPOILER=False   # Send uploaded videos as spoiler media (default: False)
#FINISHED_PROGRESS_STR=🧡        # Progress bar "filled" character
#UN_FINISHED_PROGRESS_STR=🤍     # Progress bar "empty" character


# ───────────────────────────────────────────────────────────────────
#  ERROR REPORTING
# ───────────────────────────────────────────────────────────────────

#REPORT_FAILED=True              # Master switch for failure reporting (default: True)
                                 # Set to False to enable the two vars below independently.
#REPORT_FAILED_DL=False          # Report failed downloads to owner (default: False)
#REPORT_FAILED_ENC=False         # Report failed encodes to owner (default: False)
#NOTIFY_ON_COMPLETE=True         # Notify owner on encode completion (default: True)
#NOTIFY_ON_FAIL=True             # Notify owner on encode failure (default: True)


# ───────────────────────────────────────────────────────────────────
#  RSS
# ───────────────────────────────────────────────────────────────────

#RSS_CHAT=                       # Default chat ID to send RSS feed items
#RSS_DELAY=60                    # Interval in seconds between RSS feed polls (default: 60)
#RSS_DIRECT=True                 # Pass RSS links directly to the bot queue (default: True)


# ───────────────────────────────────────────────────────────────────
#  TELEGRAPH
# ───────────────────────────────────────────────────────────────────

#TELEGRAPH_API=https://api.telegra.ph   # Custom Telegraph API endpoint (default: api.telegra.ph)
#TELEGRAPH_AUTHOR=               # Author name shown on Telegraph media info pages


# ───────────────────────────────────────────────────────────────────
#  BOT COMMANDS & MISC
# ───────────────────────────────────────────────────────────────────

#CMD_SUFFIX=                     # Suffix appended to all commands. e.g: _enc  → /start_enc
#OVR=                            # Override string (internal use)
#DEV=0                           # Secondary dev user ID (gets eval/bash access like owner)
#DL_STUFF=                       # Comma-separated URLs to download automatically on startup

# Update settings
#ALWAYS_DEPLOY_LATEST=False      # Pull latest upstream code on every startup (default: False)
#UPSTREAM_REPO=                  # Custom git repo URL for /update command
#UPSTREAM_BRANCH=                # Branch name for custom upstream repo


# ───────────────────────────────────────────────────────────────────
#  ENCODING BEHAVIOUR
# ───────────────────────────────────────────────────────────────────

#AUTO_ENCODE=False               # Auto-encode files sent to bot or group (default: False)
                                  # Set True to restore old behaviour of encoding on file receive.
                                  # When False (default), use /add reply to a file to queue it.

# ───────────────────────────────────────────────────────────────────
#  🚀  HEROKU / INFRA  (NEW in this fork)
# ───────────────────────────────────────────────────────────────────

#HEALTH_PORT=0                   # Expose HTTP health-check on this port (0 = disabled).
                                 # On Heroku set this to the value of $PORT config var.
                                 # Responds 200 OK at / and /health — keeps dyno alive.

#AUTO_CLEAN_INTERVAL=0           # Clean temp/download dirs every N seconds (0 = disabled).
                                 # Recommended: 3600 (1 hour) on low-storage servers.

# ───────────────────────────────────────────────────────────────────
#  🧠  MEMORY TUNING  (NEW)
# ───────────────────────────────────────────────────────────────────
# Removed Qbittorrent Completely)
#ENABLE_ARIA2=True                # Start aria2 (used by /leech /l for direct links
                                  # and magnet/torrent links). Much lighter than
                                  # qBittorrent (~10-30MB). Set False to disable.

# DYNO is set automatically by Heroku — do not set manually.
# DATABASE_URL is set automatically by the mLab addon — or supply your own Atlas URI.
